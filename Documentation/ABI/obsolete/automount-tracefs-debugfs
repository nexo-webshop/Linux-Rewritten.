      # writing reseravation limit: 5368709120
      ...
      # write_to_hugetlbfs: Error mapping the file: Cannot allocate memory
      # Waiting for hugetlb memory reservation to reach size 2684354560.
      # 0
      # Waiting for hugetlb memory reservation to reach size 2684354560.
      # 0
      ...
    
